{%- comment -%}
  TISIDIAN — Newsletter / Inner Circle email capture
  Place at the bottom of the homepage, just above the footer.
  No discounts. No promotions. Just early access framing.
{%- endcomment -%}

<div class="tis-newsletter">
  <div class="tis-newsletter__inner">
    <p class="tis-newsletter__overline">{{ section.settings.overline }}</p>
    <h2 class="tis-newsletter__heading">{{ section.settings.heading }}</h2>
    <p class="tis-newsletter__body">{{ section.settings.body }}</p>

    {% form 'customer', class: 'tis-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder }}"
        class="tis-newsletter__input"
        required
        autocomplete="email"
      >
      <button type="submit" class="tis-newsletter__button">
        {{ section.settings.button_label }}
      </button>

      {%- if form.posted_successfully? -%}
        <p class="tis-newsletter__msg tis-newsletter__msg--ok">Subscribed.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="tis-newsletter__msg tis-newsletter__msg--err">{{ form.errors.messages.email }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</div>

<style>
  .tis-newsletter {
    background: #0A0813;
    padding: 96px 24px;
    text-align: center;
    border-top: 1px solid #2A2440;
  }
  .tis-newsletter__inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .tis-newsletter__overline {
    font-family: 'JetBrains Mono', 'IBM Plex Mono', monospace !important;
    font-size: 10px !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: #C9A96E !important;
    margin: 0 0 16px 0 !important;
  }
  .tis-newsletter__heading {
    font-family: 'Cormorant Garamond', serif !important;
    font-weight: 500 !important;
    font-size: 32px !important;
    letter-spacing: 0.12em !important;
    color: #F2EFE8 !important;
    text-transform: uppercase !important;
    margin: 0 0 16px 0 !important;
  }
  .tis-newsletter__body {
    font-family: 'Inter', sans-serif !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: #9590A8 !important;
    margin: 0 0 32px 0;
    font-style: italic;
  }
  .tis-newsletter__form {
    display: flex;
    gap: 0;
    max-width: 480px;
    margin: 0 auto;
  }
  .tis-newsletter__input {
    flex: 1;
    background: #14101F !important;
    border: 1px solid #2A2440 !important;
    border-right: none !important;
    color: #F2EFE8 !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 13px !important;
    padding: 14px 18px !important;
    letter-spacing: 0.02em;
    border-radius: 0 !important;
  }
  .tis-newsletter__input:focus {
    outline: none !important;
    border-color: #C9A96E !important;
  }
  .tis-newsletter__input::placeholder {
    color: #5B5670;
    font-style: italic;
  }
  .tis-newsletter__button {
    background: transparent;
    color: #C9A96E;
    border: 1px solid #C9A96E;
    font-family: 'JetBrains Mono', 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 14px 28px;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 0;
  }
  .tis-newsletter__button:hover {
    background: #C9A96E;
    color: #0A0813;
  }
  .tis-newsletter__msg {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 16px;
  }
  .tis-newsletter__msg--ok { color: #C9A96E; }
  .tis-newsletter__msg--err { color: #6B1F2C; }

  @media (max-width: 749px) {
    .tis-newsletter { padding: 64px 20px; }
    .tis-newsletter__heading {
      font-size: 24px !important;
      letter-spacing: 0.1em !important;
    }
    .tis-newsletter__form {
      flex-direction: column;
      gap: 8px;
    }
    .tis-newsletter__input {
      border-right: 1px solid #2A2440 !important;
    }
  }
</style>

{% schema %}
{
  "name": "TIS Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline (gold, mono caps)",
      "default": "THE INNER CIRCLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE INNER CIRCLE"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body (italic)",
      "default": "Early access to released pieces. No noise. No promotions. One email per release."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email input placeholder",
      "default": "your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SUBSCRIBE"
    }
  ],
  "presets": [
    {
      "name": "TIS Newsletter"
    }
  ]
}
{% endschema %}
